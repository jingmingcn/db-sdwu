3. SQL操作参考答案
	1.	查询“计算机学院”的所有学生姓名和所属学院名称：

SELECT S.Name, D.DeptName
FROM Student S
JOIN Department D ON S.DeptID = D.DeptID
WHERE D.DeptName = '计算机学院';

	2.	查询张老师所教的所有课程名称：

SELECT C.Name
FROM Course C
JOIN Teacher T ON C.TeaID = T.TeaID
WHERE T.Name = '张老师';

	3.	查询每门课程的平均成绩，按成绩从高到低排序：

SELECT C.Name, AVG(E.Grade) AS AvgGrade
FROM Course C
JOIN Enrollment E ON C.CourseID = E.CourseID
GROUP BY C.Name
ORDER BY AvgGrade DESC;

	4.	查询没有选修任何课程的学生：

SELECT S.Name
FROM Student S
LEFT JOIN Enrollment E ON S.StuID = E.StuID
WHERE E.CourseID IS NULL;

	5.	插入一个学生选课记录（检查是否已选）：

-- 假设要插入学生 20231001 选修课程 CS101，成绩待定
INSERT INTO Enrollment (StuID, CourseID, Grade)
SELECT '20231001', 'CS101', NULL
WHERE NOT EXISTS (
    SELECT * FROM Enrollment
    WHERE StuID = '20231001' AND CourseID = 'CS101'
);

	6.	删除一门课程（连带选课记录）：

-- 假设删除课程 CS101
DELETE FROM Enrollment WHERE CourseID = 'CS101';
DELETE FROM Course WHERE CourseID = 'CS101';


