4. 事务处理示例

-- 修改学生 20231001 在课程 CS101 的成绩为 85
BEGIN;

-- 备份旧成绩
INSERT INTO Backup_Enrollment (StuID, CourseID, Grade)
SELECT StuID, CourseID, Grade
FROM Enrollment
WHERE StuID = '20231001' AND CourseID = 'CS101';

-- 更新成绩
UPDATE Enrollment
SET Grade = 85
WHERE StuID = '20231001' AND CourseID = 'CS101';

-- 检查是否更新成功
-- 假设检查成功则提交，否则回滚
-- 模拟：假如没有异常

COMMIT;

-- 如果过程中发现问题（如未找到记录）
-- ROLLBACK;

（说明：Backup_Enrollment 表需事先创建，结构与 Enrollment 相同。）

